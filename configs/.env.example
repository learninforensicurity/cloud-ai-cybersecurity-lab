# Cloud AI Cybersecurity Lab
# Example environment configuration.
#
# COPY this file to a local .env file only when the runtime requires it.
# NEVER commit the real .env file.
#
# Do not place real API keys in this file.

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

LAB_ENV=development
LAB_NAME=cloud-ai-cybersecurity-lab

# Use an environment-specific value on the runtime VM.
# Do not commit a real public IP here.
LAB_HOST=<LAB-IP>

# ------------------------------------------------------------
# Open WebUI
# ------------------------------------------------------------

OPEN_WEBUI_PORT=3000

# ------------------------------------------------------------
# OpenClaw
# ------------------------------------------------------------

OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789

# ------------------------------------------------------------
# AI providers
# ------------------------------------------------------------

# Set these only in the real protected environment.
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ------------------------------------------------------------
# Model routing
# ------------------------------------------------------------

PRIMARY_MODEL=openrouter/free
FALLBACK_MODEL_1=google/gemini-3.5-flash-lite
FALLBACK_MODEL_2=opencode/big-pickle
FALLBACK_MODEL_3=opencode/longcat-2.5-preview-free
FALLBACK_MODEL_4=opencode/mimo-v2.6-flash-free
FALLBACK_MODEL_5=opencode/nemotron-3.5-lightning-free
FALLBACK_MODEL_6=opencode/space-bunny-free

# ------------------------------------------------------------
# Controlled laboratory
# ------------------------------------------------------------

VSFTPD_HOST=127.0.0.1
VSFTPD_PORT=2121
VSFTPD_BACKDOOR_PORT=6200

# Keep deliberately vulnerable services local-only unless
# there is a documented and authorized reason to expose them.

# ------------------------------------------------------------
# Documentation / evidence
# ------------------------------------------------------------

EVIDENCE_REDACT_SECRETS=true
